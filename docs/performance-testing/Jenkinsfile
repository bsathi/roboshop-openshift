// Jenkinsfile - roboshop performance test pipeline (Windows Jenkins agent + WSL2 JMeter)
//
// This pipeline runs on a Windows Jenkins agent (matches the existing Jenkins install on
// Windows 10) but executes the actual JMeter test inside WSL2 Ubuntu-26.04, reusing the
// exact JMeter/Java/Beanshell environment already validated throughout this project -
// rather than installing and re-validating a second, separate JMeter setup natively on
// Windows.
//
// Requires on the Jenkins Windows agent:
//   - WSL2 with the Ubuntu-26.04 distro already installed and working (confirmed present)
//   - JMeter 5.6.3 already installed inside that WSL2 distro (confirmed present)
//   - python3 available inside WSL2 (confirmed present, used for quality_gate.py)
//   - The "HTML Publisher" Jenkins plugin installed (Manage Jenkins -> Plugins)
//
// IMPORTANT #1: if Jenkins runs as a Windows Service under a service account (e.g. "Local
// System") rather than your own interactive Windows user, that account may not have
// access to your user's WSL2 distro by default - WSL2 distros are registered per-Windows-
// user. If you're running Jenkins interactively (java -jar jenkins.war under your own
// login, as in this project), this does not apply - Jenkins already shares your own WSL2
// access.
//
// IMPORTANT #2: every "wsl" call below explicitly targets "-d Ubuntu-26.04" rather than
// relying on WSL's default distro. This project's WSL2 install has two registered distros
// (Ubuntu-26.04, plus a minimal "docker-desktop" utility distro Docker Desktop registers
// for its own internal use) - docker-desktop was found to be the default, meaning a bare
// "wsl <command>" silently routed to a distro with no bash/java/jmeter/python3 installed.
// Always name the distro explicitly in automation for this reason.
//
// IMPORTANT #3: jmeter is invoked by its FULL ABSOLUTE PATH (/opt/apache-jmeter-5.6.3/bin/
// jmeter) rather than relying on PATH. Two earlier approaches were tried and abandoned:
// (a) "bash -lc" (login shell) did not reliably source .bashrc's PATH addition when
// invoked non-interactively via wsl.exe from Windows - a known WSL shell-profile quirk;
// (b) explicitly exporting PATH inline (export PATH=...:$PATH) broke instead, because
// this WSL2 install inherits a very large Windows-side PATH via WSL interop containing
// entries with spaces and parentheses (e.g. "Program Files (x86)", "Intel(R) Management
// Engine Components") - left unquoted, bash's word-splitting on that expansion produced a
// genuine syntax error. Calling jmeter by its full path sidesteps both problems entirely;
// java and python3 need no special handling at all, since they're standard apt-installed
// binaries already on the baseline system PATH regardless of shell/profile context -
// confirmed directly: "wsl -d Ubuntu-26.04 bash -c "java -version && python3 --version &&
// /opt/apache-jmeter-5.6.3/bin/jmeter --version"" succeeded with no PATH changes needed.

pipeline {
    parameters {
        choice(name: 'NODE_LABEL', choices: ['built-in', 'Custom-Node1'],
               description: 'Which Jenkins node to run this pipeline on. "built-in" is the Windows 10 desktop Jenkins itself runs on (java -jar jenkins.war); "Custom-Node1" is the separate JNLP agent process on the same desktop (D:\\jenkins-agent) - both reach the same WSL2/JMeter environment, since they run on the same physical machine.')
        choice(name: 'JMETER_RUNTIME', choices: ['wsl', 'windows'],
               description: '"wsl" (default) runs JMeter inside WSL2 Ubuntu-26.04 (/opt/apache-jmeter-5.6.3), the environment validated throughout this whole project. "windows" runs the native Windows JMeter install directly (D:\\software\\jmeter\\apache-jmeter-5.6.3\\bin\\jmeter.bat) via a plain bat step - requires a native Windows JDK/JRE already installed and on PATH for whichever node runs this pipeline (verify manually first: java -version, then jmeter.bat --version, from a plain cmd.exe window). Either way, quality_gate.py always runs via WSL2 python3, since it only parses the resulting .jtl file and does not care which engine produced it.')
        string(name: 'TARGET_HOST', defaultValue: 'frontend-bsathi2020-dev.apps.rm3.7wse.p1.openshiftapps.com',
               description: 'roboshop frontend Route hostname to load test')
        string(name: 'THREADS', defaultValue: '10', description: 'Concurrent virtual users')
        string(name: 'RAMPUP', defaultValue: '10', description: 'Ramp-up period in seconds')
        string(name: 'LOOPS', defaultValue: '5', description: 'Iterations per virtual user')
    }

    agent { label params.NODE_LABEL }

    environment {
        JMX_FILE            = 'roboshop-performance-test.jmx'
        RESULTS_FILE        = 'results.jtl'
        REPORT_DIR          = 'performance-report'
        ORDER_RESULTS       = 'order-results.txt'
        JMETER_BIN          = '/opt/apache-jmeter-5.6.3/bin/jmeter'
        JMETER_BIN_WINDOWS  = 'D:\\software\\jmeter\\apache-jmeter-5.6.3\\bin\\jmeter.bat'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                bat 'dir'
            }
        }

        stage('Resolve WSL Workspace Path') {
            steps {
                script {
                    // Translate the Windows workspace path Jenkins gave us into the
                    // equivalent path as seen from inside WSL2, using WSL's own
                    // wslpath utility rather than a hand-written regex - more robust
                    // across different Windows usernames/drive letters.
                    env.WSL_WORKSPACE = bat(
                        script: "@wsl -d Ubuntu-26.04 wslpath -a \"${env.WORKSPACE}\"",
                        returnStdout: true
                    ).trim()
                    echo "Windows workspace: ${env.WORKSPACE}"
                    echo "WSL2-visible path: ${env.WSL_WORKSPACE}"
                }
            }
        }

        stage('Verify Test Runtime Environment') {
            steps {
                script {
                    // python3 (for quality_gate.py) is needed via WSL2 no matter which
                    // engine actually runs the load test.
                    bat "wsl -d Ubuntu-26.04 bash -c \"python3 --version\""

                    if (params.JMETER_RUNTIME == 'windows') {
                        bat 'java -version'
                        bat "\"${JMETER_BIN_WINDOWS}\" --version"
                    } else {
                        bat "wsl -d Ubuntu-26.04 bash -c \"java -version && ${JMETER_BIN} --version\""
                    }
                }
            }
        }

        stage('Run JMeter Load Test') {
            steps {
                script {
                    // Clean up any previous run's output first, always via WSL2 - a
                    // plain file delete doesn't care which OS process wrote the files.
                    bat "wsl -d Ubuntu-26.04 bash -c \"cd '${env.WSL_WORKSPACE}/docs/performance-testing' && rm -rf ${REPORT_DIR} ${RESULTS_FILE} ${ORDER_RESULTS}\""

                    if (params.JMETER_RUNTIME == 'windows') {
                        dir('docs/performance-testing') {
                            bat "\"${JMETER_BIN_WINDOWS}\" -n -t ${JMX_FILE} -JHOST=%TARGET_HOST% -JTHREADS=%THREADS% -JRAMPUP=%RAMPUP% -JLOOPS=%LOOPS% -l ${RESULTS_FILE} -e -o ${REPORT_DIR}"
                        }
                    } else {
                        bat "wsl -d Ubuntu-26.04 bash -c \"cd '${env.WSL_WORKSPACE}/docs/performance-testing' && ${JMETER_BIN} -n -t ${JMX_FILE} -JHOST=%TARGET_HOST% -JTHREADS=%THREADS% -JRAMPUP=%RAMPUP% -JLOOPS=%LOOPS% -l ${RESULTS_FILE} -e -o ${REPORT_DIR}\""
                    }
                }
            }
        }

        stage('Archive Results') {
            // Deliberately runs BEFORE the quality gate, not after. A failing gate calls
            // error(), which immediately aborts the pipeline - if archiving ran afterward,
            // a failed build would never get its HTML report published at all, which is
            // exactly backwards: the report matters most on a failing build. Archiving
            // here means the dashboard is always available, pass or fail.
            steps {
                dir('docs/performance-testing') {
                    archiveArtifacts artifacts: "${RESULTS_FILE}", allowEmptyArchive: false
                    archiveArtifacts artifacts: "${REPORT_DIR}/**", allowEmptyArchive: false
                    archiveArtifacts artifacts: "${ORDER_RESULTS}", allowEmptyArchive: true
                    publishHTML(target: [
                        reportName : 'JMeter Performance Dashboard',
                        reportDir  : "${REPORT_DIR}",
                        reportFiles: 'index.html',
                        keepAll    : true,
                        alwaysLinkToLastBuild: true,
                        allowMissing: false
                    ])
                }
            }
        }

        stage('Evaluate Quality Gate') {
            steps {
                script {
                    def exitCode = bat(
                        script: "wsl -d Ubuntu-26.04 bash -c \"cd '${env.WSL_WORKSPACE}/docs/performance-testing' && python3 quality_gate.py ${RESULTS_FILE}\"",
                        returnStatus: true
                    )
                    // Always echo the human-readable report to the build log, pass or fail:
                    bat "wsl -d Ubuntu-26.04 bash -c \"cd '${env.WSL_WORKSPACE}/docs/performance-testing' && python3 quality_gate.py ${RESULTS_FILE} || exit 0\""
                    if (exitCode != 0) {
                        currentBuild.result = 'FAILURE'
                        error("Performance quality gate FAILED - response-time SLAs, <1% failed transactions, or zero-HTTP-500 rule breached. Blocking this build.")
                    } else {
                        echo "Performance quality gate PASSED - all NFR thresholds met, zero HTTP 500s."
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Performance test passed the quality gate. Safe to proceed with deployment/promotion.'
        }
        failure {
            echo 'Performance test failed the quality gate. Deployment/promotion should be blocked - review the dashboard and quality gate report above.'
        }
        always {
            echo "Build result: ${currentBuild.result}"
        }
    }
}
