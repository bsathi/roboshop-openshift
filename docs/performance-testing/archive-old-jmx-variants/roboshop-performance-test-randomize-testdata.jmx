        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC07_Add_To_Cart" enabled="true">
          <stringProp name="TestPlan.comments">Confirmed live endpoint - path and behavior verified directly from real browser Network-tab traffic captured earlier in this project, not guessed.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/cart/add/{user}/{sku}/{qty}" enabled="true">
            <stringProp name="HTTPSampler.path">/api/cart/add/${TESTUSER}/${TEST_SKU}/2</stringProp>
