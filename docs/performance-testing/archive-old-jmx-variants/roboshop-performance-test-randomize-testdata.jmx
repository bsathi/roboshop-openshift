        <!-- ==================== TC09a: Shipping Location Match (new) ====================
             Discovered via Chrome DevTools HAR export analysis of a real manual checkout:
             the browser calls this location-lookup endpoint before calc/confirm. Its
             result isn't wired into later steps here (calc uses a fixed, known city uuid
             directly), but it's included as its own transaction since it's a real part of
             the checkout flow's traffic profile and worth including in the NFR baseline. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC09a_Shipping_Match" enabled="true">
          <stringProp name="TestPlan.comments">Discovered via Chrome DevTools HAR export analysis of a real manual checkout: the browser calls this location-lookup endpoint before calc/confirm. Its result isn't wired into later steps here (calc uses a fixed, known city uuid directly), but it's included as its own transaction since it's a real part of the checkout flow's traffic profile.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/shipping/match/{country}/{query}" enabled="true">
            <stringProp name="HTTPSampler.path">/api/shipping/match/${SHIPPING_COUNTRY_CODE}/${SHIPPING_LOCATION_QUERY}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2000ms">
              <stringProp name="DurationAssertion.duration">2000</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ==================== TC09b: Shipping Calc (confirmed live endpoint) ====================
             Uses a fixed, real city: Pittsburgh, PA, USA -> uuid 6061998, looked up directly
             from the mysql cities table. Confirmed via curl: returns {"distance":...,"cost":...}.
             DISTANCE and COST are extracted here via a native JSONPostProcessor (JSON Path,
             no scripting engine involved) so TC09c can build the confirm payload from them. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC09b_Shipping_Calc_Pittsburgh" enabled="true">
          <stringProp name="TestPlan.comments">Uses a fixed, real city: Pittsburgh, PA, USA -> uuid 6061998, looked up directly from the mysql cities table. Confirmed via curl: returns {"distance":...,"cost":...}. DISTANCE and COST are extracted here via a native JSON Extractor (JSON Path, no scripting engine involved) so TC09c can build the confirm payload from them.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/shipping/calc/{cityUuid}" enabled="true">
            <stringProp name="HTTPSampler.path">/api/shipping/calc/${SHIPPING_CITY_UUID}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2000ms">
              <stringProp name="DurationAssertion.duration">2000</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract DISTANCE" enabled="true">
              <stringProp name="TestPlan.comments">Split into two separate single-purpose extractors (rather than one combined semicolon-delimited element) after a real JMeter run showed both DISTANCE and COST coming through as literal, unresolved ${DISTANCE}/${COST} text in the downstream confirm request - splitting removes ambiguity about which extraction is failing if this recurs, and is a more universally reliable JMeter pattern.</stringProp>
              <stringProp name="JSONPostProcessor.referenceNames">DISTANCE</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.distance</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">EXTRACT_FAILED_DISTANCE</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract COST" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">COST</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.cost</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">EXTRACT_FAILED_COST</stringProp>
            </JSONPostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ==================== TC09c: Shipping Confirm (new - now confirmed working) ====================
             ROOT CAUSE OF EARLIER FAILURE, now resolved: this endpoint was previously tested
             manually via curl with a body of {"distance":...,"cost":...} only, and returned
             404. Analysis of a real, successful manual checkout via Chrome DevTools' HAR
             export revealed the actual required payload also includes a "location" field
             (a human-readable label, e.g. "USA Pittsburgh") - without it, this deployment's
             shipping service does not route the request the same way. With all three fields
             present, this call succeeds and returns the cart JSON with shipping merged in
             (a 'SHIP' line item added). That response is captured into CONFIRM_CART_JSON via
             a beanshell JSR223PostProcessor (not Groovy - see the note on TC01's PreProcessor
             for why) for TC10 to use as its payment body. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC09c_Shipping_Confirm" enabled="true">
          <stringProp name="TestPlan.comments">ROOT CAUSE, RESOLVED: manual curl testing with body {"distance":...,"cost":...} returned 404. Chrome DevTools HAR analysis of a real successful checkout revealed the required payload also needs a "location" field (e.g. "USA Pittsburgh") - without it this deployment's shipping service does not route the request the same way. With all three fields present this call succeeds and returns the cart JSON with a "SHIP" line item merged in. Response captured into CONFIRM_CART_JSON for TC10.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/shipping/confirm/{user}" enabled="true">
            <stringProp name="TestPlan.comments">use_keepalive set to false as a mitigation trial for intermittent 404s (~18% of runs at 10 concurrent threads, 0% at 1 thread) - testing whether HTTP connection reuse under concurrent POST load is a contributing factor. Remove/revert once root cause is confirmed via server-side evidence (pod restarts, resource throttling, or full request/response capture).</stringProp>
            <stringProp name="HTTPSampler.path">/api/shipping/confirm/${TESTUSER}</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">false</boolProp>
            <stringProp name="HTTPSampler.postBodyRaw">true</stringProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{"distance":${DISTANCE},"cost":${COST},"location":"${SHIPPING_LOCATION_LABEL}"}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type JSON">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json;charset=UTF-8</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2000ms">
              <stringProp name="DurationAssertion.duration">2000</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Confirmed Cart JSON" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">vars.put("CONFIRM_CART_JSON", prev.getResponseDataAsString());</stringProp>
              <stringProp name="scriptLanguage">beanshell</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ==================== TC10: Checkout / Payment — RE-ENABLED ====================
             RESOLVED. Previously disabled after confirming three things via manual curl
             testing: (1) payment needs the actual cart JSON as its body, not {}; (2) with
             a pre-shipping cart, payment correctly rejects with 400 "cart not valid"; (3)
             the shipping /confirm endpoint 404'd on every manually-constructed payload
             tried at the time. Root cause of (3), found via Chrome DevTools HAR analysis
             of a real successful manual checkout: the confirm payload requires a
             "location" field in addition to distance/cost (see TC09c). With that field
             included, confirm succeeds, and posting its response (the shipping-merged
             cart, captured as CONFIRM_CART_JSON) to payment now completes the order
             successfully. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC10_Checkout_Payment" enabled="true">
          <stringProp name="TestPlan.comments">RE-ENABLED. Was disabled after confirming payment needs the real cart JSON as body (not {}), and a pre-shipping cart is correctly rejected with "cart not valid". Root cause of the blocking /confirm 404 found via HAR analysis (see TC09c) - a missing "location" field. Now posts CONFIRM_CART_JSON (the shipping-merged cart from TC09c) and completes successfully.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/payment/pay/{user}" enabled="true">
            <stringProp name="HTTPSampler.path">/api/payment/pay/${TESTUSER}</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <stringProp name="HTTPSampler.postBodyRaw">true</stringProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${CONFIRM_CART_JSON}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type JSON">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json;charset=UTF-8</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract Order ID" enabled="true">
              <stringProp name="TestPlan.comments">Confirmed via Chrome DevTools HAR analysis of a real successful checkout: the payment response is a minimal single-field object, {"orderid":"&lt;uuid&gt;"}. Extracted here via native JSON Path (no scripting engine) so the downstream file-capture step can write a clean ORDER_ID column instead of the full raw response body.</stringProp>
              <stringProp name="JSONPostProcessor.referenceNames">ORDER_ID</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.orderid</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2500ms">
              <stringProp name="DurationAssertion.duration">2500</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Order Result to File" enabled="true">
              <stringProp name="TestPlan.comments">Writes one pipe-delimited line per completed order to RESULTS_TXT (default order-results.txt, in JMeter's working directory unless a full path is given via -JRESULTS_TXT). Fields: Timestamp|TestUser|OrderID|PaymentStatusCode|ConfirmedCartJSON. OrderID is extracted by the preceding JSONPostProcessor from the payment response's "orderid" field (confirmed via HAR analysis of a real successful checkout). A header row is written once, automatically, if the file doesn't already exist. Wrapped in synchronized(props) since 10 concurrent threads may reach this at the same moment and file writes are not otherwise thread-safe. Uses beanshell, not groovy - same JDK 25 compatibility reason as TC01's TESTUSER generator.</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">String outFile = vars.get("RESULTS_TXT");
if (outFile == null || outFile.length() == 0) { outFile = "order-results.txt"; }

String testUser = vars.get("TESTUSER");
String cartJson = vars.get("CONFIRM_CART_JSON");
if (cartJson == null) { cartJson = ""; }
String orderId = vars.get("ORDER_ID");
if (orderId == null) { orderId = ""; }
String paymentCode = String.valueOf(prev.getResponseCode());
String ts = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date());

String safeCart = cartJson.replace("\n", " ").replace("\r", " ").replace("|", "/");

synchronized (props) {
    java.io.File f = new java.io.File(outFile);
    boolean writeHeader = !f.exists();
    java.io.FileWriter fw = new java.io.FileWriter(f, true);
    if (writeHeader) {
        fw.write("Timestamp|TestUser|OrderID|PaymentStatusCode|ConfirmedCartJSON");
        fw.write(System.getProperty("line.separator"));
    }
    fw.write(ts + "|" + testUser + "|" + orderId + "|" + paymentCode + "|" + safeCart);
    fw.write(System.getProperty("line.separator"));
    fw.close();
}</stringProp>
              <stringProp name="scriptLanguage">beanshell</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

      </hashTree>

      <!-- ==================== Listeners ==================== -->
