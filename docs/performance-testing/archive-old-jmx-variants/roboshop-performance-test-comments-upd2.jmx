          </hashTree>
        </hashTree>

        <!-- ==================== TC06: Get Unique/Anonymous ID (confirmed live endpoint) ==================== -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC06_Get_UniqueId" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
