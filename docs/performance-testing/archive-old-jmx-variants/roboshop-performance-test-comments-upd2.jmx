        <!-- ==================== TC08: View Cart ====================
             FIXED PATH: /api/cart/cart/{user} - "cart" appears twice (once for the nginx
             routing prefix, once as the cart service's actual route). CART_JSON is
             captured here for diagnostic/reference purposes only - TC10 now uses
             CONFIRM_CART_JSON (captured in TC09c) as its payment body instead, since
             payment requires the shipping-merged cart, not the pre-shipping one. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC08_View_Cart" enabled="true">
          <stringProp name="TestPlan.comments">FIXED PATH: /api/cart/cart/{user} - "cart" appears twice (once for the nginx routing prefix, once as the cart service's actual route). /api/cart/{user} alone 404s. CART_JSON is captured here for diagnostic/reference purposes only - TC10 uses CONFIRM_CART_JSON (captured in TC09c) as its payment body instead, since payment requires the shipping-merged cart, not the pre-shipping one.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/cart/cart/{user}" enabled="true">
            <stringProp name="HTTPSampler.path">/api/cart/cart/${TESTUSER}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 1000ms">
              <stringProp name="DurationAssertion.duration">1000</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture Cart JSON (diagnostic only)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">vars.put("CART_JSON", prev.getResponseDataAsString());</stringProp>
              <stringProp name="scriptLanguage">beanshell</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ==================== TC09: Shipping Codes (confirmed live endpoint) ==================== -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC09_Shipping_Lookup" enabled="true">
          <stringProp name="TestPlan.comments">Confirmed live endpoint - lists available shipping country codes. No response-code assertion (only a duration check) since this was validated before the full assertion pattern was standardized across later transactions.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/shipping/codes" enabled="true">
            <stringProp name="HTTPSampler.path">/api/shipping/codes</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
