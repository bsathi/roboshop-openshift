<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="roboshop-performance-test" enabled="true">
      <stringProp name="TestPlan.comments">roboshop NFR baseline: 10 concurrent users. See performance-testing-README.md for NFR targets. TC10 (payment) is now ENABLED - the full checkout chain (match -&gt; calc -&gt; confirm -&gt; pay) was reverse-engineered from a working manual browser checkout via Chrome DevTools HAR export. See comments on TC09a/TC09c/TC10 for details.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(PROTOCOL,http)}</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,frontend-bsathi2020-dev.apps.rm3.7wse.p1.openshiftapps.com)}</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(PORT,80)}</stringProp>
          </elementProp>
          <elementProp name="TEST_SKU" elementType="Argument">
            <stringProp name="Argument.name">TEST_SKU</stringProp>
            <stringProp name="Argument.value">${__P(TEST_SKU,EMM)}</stringProp>
          </elementProp>
          <elementProp name="SHIPPING_CITY_UUID" elementType="Argument">
            <stringProp name="Argument.name">SHIPPING_CITY_UUID</stringProp>
            <stringProp name="Argument.value">${__P(SHIPPING_CITY_UUID,6061998)}</stringProp>
          </elementProp>
          <elementProp name="SHIPPING_COUNTRY_CODE" elementType="Argument">
            <stringProp name="Argument.name">SHIPPING_COUNTRY_CODE</stringProp>
            <stringProp name="Argument.value">${__P(SHIPPING_COUNTRY_CODE,us)}</stringProp>
          </elementProp>
          <elementProp name="SHIPPING_LOCATION_QUERY" elementType="Argument">
            <stringProp name="Argument.name">SHIPPING_LOCATION_QUERY</stringProp>
            <stringProp name="Argument.value">${__P(SHIPPING_LOCATION_QUERY,Pittsburgh)}</stringProp>
          </elementProp>
          <elementProp name="SHIPPING_LOCATION_LABEL" elementType="Argument">
            <stringProp name="Argument.name">SHIPPING_LOCATION_LABEL</stringProp>
            <stringProp name="Argument.value">${__P(SHIPPING_LOCATION_LABEL,USA Pittsburgh)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- ==================== HTTP Request Defaults ==================== -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">15000</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- ==================== Cookie & Cache Managers ==================== -->
      <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
        <collectionProp name="CookieManager.cookies"/>
        <boolProp name="CookieManager.clearEachIteration">false</boolProp>
        <stringProp name="CookieManager.policy">standard</stringProp>
      </CookieManager>
      <hashTree/>
      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager" testname="HTTP Cache Manager" enabled="true">
        <boolProp name="clearEachIteration">false</boolProp>
        <boolProp name="useExpires">true</boolProp>
      </CacheManager>
      <hashTree/>

      <!-- ==================== Thread Group: 10 concurrent users ==================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="10_Concurrent_Users" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(LOOPS,5)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(THREADS,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(RAMPUP,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>

        <!-- Constant timer for realistic pacing between transactions -->
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think Time (1s)" enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
        </ConstantTimer>
        <hashTree/>

        <!-- ==================== TC01: Browse Home Page ==================== -->
        <!-- Generate TESTUSER once per iteration here (TC01 runs once/iteration; PreProcessor
             fires before TC01's own sampler, so every later transaction in this iteration
             reads the same value via ${TESTUSER}). Uses beanshell, not groovy/javascript,
             because JMeter 5.6.3's groovy engine fails to compile under JDK 25
             ("Unsupported class file major version 69"), and 'javascript' has no engine
             registered at all since JDK 15+ dropped Nashorn. Beanshell ships inside JMeter
             itself and has no JVM-scripting-engine dependency. -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC01_Browse_Home" enabled="true">
          <stringProp name="TestPlan.comments">Generates TESTUSER once per iteration via the child JSR223PreProcessor. Uses beanshell, not groovy/javascript: JMeter 5.6.3's groovy engine fails to compile under JDK 25 ("Unsupported class file major version 69"), and 'javascript' has no engine registered at all since JDK 15+ dropped Nashorn. Beanshell ships inside JMeter itself and has no JVM-scripting-engine dependency.</stringProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate TESTUSER" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">vars.put("TESTUSER", "perftest_" + ctx.getThreadNum() + "_" + vars.getIteration() + "_" + (System.currentTimeMillis() % 100000));</stringProp>
            <stringProp name="scriptLanguage">beanshell</stringProp>
          </JSR223PreProcessor>
          <hashTree/>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /" enabled="true">
            <stringProp name="HTTPSampler.path">/</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration &lt; 2500ms">
              <stringProp name="DurationAssertion.duration">2500</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- ==================== TC02: Browse Catalogue ==================== -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC02_Browse_Catalogue" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/catalogue/products" enabled="true">
            <stringProp name="HTTPSampler.path">/api/catalogue/products</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 OK">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
